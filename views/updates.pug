doctype html
html
  head
    title= title
    link(rel='stylesheet', href='/css/style.css')
  body
    h1 Update Custom Object Form
    form(action='/update-cobj', method='POST')
      each p in props
        label(for=p)= p
        input(type='text', id=p, name=p, required)
      input(type='submit', value='Save')
    a(href='/') Return to the homepage
