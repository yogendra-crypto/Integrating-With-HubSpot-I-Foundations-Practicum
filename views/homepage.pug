doctype html
html
    head
        title= title
        meta(name="viewport", content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        main
            h1 Books
            a.add-link(href="/update-cobj") Add to this table

            table
                thead
                    tr
                        th Name
                        th Author
                        th Genre
                        th Price
                tbody
                    each book in data
                        tr
                            td= book.properties.name
                            td= book.properties.author
                            td= book.properties.genre
                            td= book.properties.price